# Power BI writes CRLF. Normalise in the repo, restore CRLF on checkout so
# Desktop doesn't rewrite every file the moment you open the project.
*.tmdl   text eol=crlf
*.json   text eol=crlf
*.pbip   text eol=crlf
*.pbir   text eol=crlf
*.pbism  text eol=crlf
*.platform text eol=crlf

# Binary / never-diff
*.abf    binary
*.pbix   binary
