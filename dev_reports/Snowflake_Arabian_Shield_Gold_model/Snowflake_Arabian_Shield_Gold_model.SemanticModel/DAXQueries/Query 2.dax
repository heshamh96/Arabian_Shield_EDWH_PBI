DEFINE
	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			'A_REF_GENDER'[EN_NAME],
			"CountPOLICY_ID", CALCULATE(COUNTA('C_DIM_POLICY_MASTER'[POLICY_ID]))
		)

	VAR __DS0BodyLimited = 
		TOPN(1002, __DS0Core, [CountPOLICY_ID], 0, 'A_REF_GENDER'[EN_NAME], 1)

EVALUATE
	__DS0BodyLimited

ORDER BY
	[CountPOLICY_ID] DESC, 'A_REF_GENDER'[EN_NAME]