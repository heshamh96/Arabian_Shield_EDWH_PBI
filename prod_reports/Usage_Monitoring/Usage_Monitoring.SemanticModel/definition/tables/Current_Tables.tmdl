/// Current state of every monitored table across BRONZE, SILVER and GOLD.
table Current_Tables
	lineageTag: 6b0c982c-8960-458b-b326-12a1dd4ece14

	column LAYER
		dataType: string
		lineageTag: f72affac-195a-4b3e-8f27-6fdec60147b4
		summarizeBy: none
		sourceColumn: LAYER

		annotation SummarizationSetBy = Automatic

	column DATABASE_NAME
		dataType: string
		lineageTag: d2ab8ec6-17aa-45a4-9018-5465be6a721f
		summarizeBy: none
		sourceColumn: DATABASE_NAME

		annotation SummarizationSetBy = Automatic

	column SCHEMA_NAME
		dataType: string
		lineageTag: 7f9d9280-eb5a-4715-961f-a9986bcbde11
		summarizeBy: none
		sourceColumn: SCHEMA_NAME

		annotation SummarizationSetBy = Automatic

	column TABLE_NAME
		dataType: string
		lineageTag: 8d78d0d2-2bd4-40bb-a394-db9fb3363fe7
		summarizeBy: none
		sourceColumn: TABLE_NAME

		annotation SummarizationSetBy = Automatic

	column IS_DYNAMIC
		dataType: string
		lineageTag: 64671fd5-1348-487c-a33a-646d6c04ee59
		summarizeBy: none
		sourceColumn: IS_DYNAMIC

		annotation SummarizationSetBy = Automatic

	column ROW_COUNT
		dataType: int64
		lineageTag: d623dc46-97e8-4643-9191-ae5fd0093d27
		summarizeBy: sum
		sourceColumn: ROW_COUNT

		annotation SummarizationSetBy = Automatic

	column BYTES
		dataType: int64
		lineageTag: 362d6fc8-36d2-4a63-843d-9b463a7d4a08
		summarizeBy: sum
		sourceColumn: BYTES

		annotation SummarizationSetBy = Automatic

	column RETENTION_TIME
		dataType: int64
		lineageTag: f6a71a5e-c31c-4fbd-9332-75d984bc42ce
		summarizeBy: none
		sourceColumn: RETENTION_TIME

		annotation SummarizationSetBy = Automatic

	column CREATED_AT
		dataType: dateTime
		lineageTag: 981e5528-5a24-4664-9e35-04e544bdd2fd
		summarizeBy: none
		sourceColumn: CREATED_AT

		annotation SummarizationSetBy = Automatic

	column LAST_ALTERED
		dataType: dateTime
		lineageTag: af9340a5-f02f-48a0-aab4-a34477ba1c16
		summarizeBy: none
		sourceColumn: LAST_ALTERED

		annotation SummarizationSetBy = Automatic

	column TABLE_COMMENT
		dataType: string
		lineageTag: c3d8e0c1-24cc-4e2b-8d02-741ea338290a
		summarizeBy: none
		sourceColumn: TABLE_COMMENT

		annotation SummarizationSetBy = Automatic

	hierarchy Inventory
		lineageTag: e04455a3-a130-42c2-b6ab-d1792ec3bdd9

		level LAYER
			lineageTag: 244a4545-8742-459f-a6de-dfe6ec16faa9
			column: LAYER

		level SCHEMA_NAME
			lineageTag: a4114f86-27f0-4733-b2c0-50843ba2adfc
			column: SCHEMA_NAME

		level TABLE_NAME
			lineageTag: e3d217f7-3a08-4d6b-9450-f14fc52bd736
			column: TABLE_NAME

	measure 'Tables Monitored' = COUNTROWS(Current_Tables)
		formatString: #,0
		lineageTag: 8b8eed36-138d-4313-bc59-fcba5b354b41

	measure 'Current Rows' = SUM(Current_Tables[ROW_COUNT])
		formatString: #,0
		lineageTag: 46020c38-d570-4b9f-86e3-2454950425ea

	measure 'Current Storage GB' = DIVIDE(SUM(Current_Tables[BYTES]), 1073741824)
		formatString: #,0.00
		lineageTag: 319cb68c-9397-4a6f-9f7a-b2487a57b953

	measure 'Dynamic Tables' = CALCULATE([Tables Monitored], Current_Tables[IS_DYNAMIC] = "YES")
		formatString: #,0
		lineageTag: b2b8cd01-a17e-48e5-b989-eb664913c1a8

	measure 'Static Tables' = CALCULATE([Tables Monitored], Current_Tables[IS_DYNAMIC] = "NO")
		formatString: #,0
		lineageTag: d62660ad-9b37-4f1c-a0f8-97ebc41fc7ed

	measure 'Dynamic Table %' = DIVIDE([Dynamic Tables], [Tables Monitored])
		formatString: 0.0%
		lineageTag: cb325dfa-fd7e-427b-9361-8aa04aaa17f8

	/// Zero-row tables - either genuinely empty or a broken pipeline.
	measure 'Empty Tables' = CALCULATE([Tables Monitored], Current_Tables[ROW_COUNT] = 0)
		formatString: #,0
		lineageTag: 5ca6ed18-2a12-4af8-8887-dfb1f54c04b5

	measure 'Empty Table %' = DIVIDE([Empty Tables], [Tables Monitored])
		formatString: 0.0%
		lineageTag: efe3cfda-be9e-48fc-92f5-4382ad41fcf8

	measure 'Avg Rows per Table' = DIVIDE([Current Rows], [Tables Monitored])
		formatString: #,0
		lineageTag: 6a55957e-1370-4bcb-a289-31e2d4f794ad

	measure 'Largest Table Rows' = MAX(Current_Tables[ROW_COUNT])
		formatString: #,0
		lineageTag: a6770739-3af7-4642-8e3e-d1c6fab66ae6

	/// Name of the biggest table by row count in the current filter.
	measure 'Largest Table' = CALCULATE(FIRSTNONBLANK(Current_Tables[TABLE_NAME], 1), TOPN(1, ALLSELECTED(Current_Tables[TABLE_NAME]), [Current Rows], DESC))
		lineageTag: e42c568a-e0f4-4750-8922-3470d576e67e

	/// Not altered in 30 days - either stable reference data or a stalled feed.
	measure 'Stale Tables (30d)' = CALCULATE([Tables Monitored], FILTER(Current_Tables, Current_Tables[LAST_ALTERED] < TODAY() - 30))
		formatString: #,0
		lineageTag: 82192f99-f3d8-4898-b171-664094dc23ea

	measure 'Avg Retention Days' = AVERAGE(Current_Tables[RETENTION_TIME])
		formatString: #,0.00
		lineageTag: bd233caa-8458-4509-93ba-9d151654120e

	/// With a 300M-row outlier present, the median describes the estate better than the mean.
	measure 'Median Rows per Table' = MEDIANX(Current_Tables, Current_Tables[ROW_COUNT])
		formatString: #,0
		lineageTag: 60eb2a95-5c7a-442e-8ac1-07b486057cde

	/// Share of all storage held by the single largest table.
	measure 'Storage Concentration %' = DIVIDE(MAXX(VALUES(Current_Tables[TABLE_NAME]), [Current Storage GB]), [Current Storage GB])
		formatString: 0.0%
		lineageTag: 072811a3-71fb-4c82-9dc6-3715f9bfc403

	measure 'Tables > 1M Rows' = CALCULATE([Tables Monitored], FILTER(Current_Tables, Current_Tables[ROW_COUNT] > 1000000))
		formatString: #,0
		lineageTag: c23e8499-31c0-4181-8e70-44648c5de92a

	measure 'Largest Table GB' = DIVIDE(MAX(Current_Tables[BYTES]), 1073741824)
		formatString: #,0.00
		lineageTag: e3236b32-bc94-41ca-b48e-da3d8b8d3954

	measure 'Newest Table Date' = MAX(Current_Tables[CREATED_AT])
		formatString: yyyy-mm-dd
		lineageTag: e5ceced1-07df-483d-a990-e22f870a5306

	/// Most recent write anywhere in the current filter - a staleness canary.
	measure 'Last Change' = MAX(Current_Tables[LAST_ALTERED])
		formatString: yyyy-mm-dd
		lineageTag: 91d9ff5c-9316-4e5e-9616-74c5e0e9dfac

	partition Current_Tables = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases(SnowflakeServer, SnowflakeWarehouse, [Role=SnowflakeRole]),
				    Db = Source{[Name=SnowflakeDatabase, Kind="Database"]}[Data],
				    Sql = Text.Replace(Text.Replace("select 'BRONZE' as LAYER, ""DATABASE"" as DATABASE_NAME, ""SCHEMA"" as SCHEMA_NAME, ""TABLE"" as TABLE_NAME, IS_DYNAMIC, ROW_COUNT, BYTES, RETENTION_TIME, cast(CREATED_AT as timestamp_ntz) as CREATED_AT, cast(LAST_ALTERED as timestamp_ntz) as LAST_ALTERED, ""COMMENT"" as TABLE_COMMENT from {DB}.{SCHEMA}.VW_BRONZE_TABLE_CURRENT_COUNT union all select 'SILVER' as LAYER, ""DATABASE"" as DATABASE_NAME, ""SCHEMA"" as SCHEMA_NAME, ""TABLE"" as TABLE_NAME, IS_DYNAMIC, ROW_COUNT, BYTES, RETENTION_TIME, cast(CREATED_AT as timestamp_ntz) as CREATED_AT, cast(LAST_ALTERED as timestamp_ntz) as LAST_ALTERED, ""COMMENT"" as TABLE_COMMENT from {DB}.{SCHEMA}.VW_SILVER_TABLE_CURRENT_COUNT union all select 'GOLD' as LAYER, ""DATABASE"" as DATABASE_NAME, ""SCHEMA"" as SCHEMA_NAME, ""TABLE"" as TABLE_NAME, IS_DYNAMIC, ROW_COUNT, BYTES, RETENTION_TIME, cast(CREATED_AT as timestamp_ntz) as CREATED_AT, cast(LAST_ALTERED as timestamp_ntz) as LAST_ALTERED, ""COMMENT"" as TABLE_COMMENT from {DB}.{SCHEMA}.VW_GOLD_TABLE_CURRENT_COUNT", "{DB}", SnowflakeDatabase), "{SCHEMA}", SnowflakeSchema),
				    Result = Value.NativeQuery(Db, Sql, null, [EnableFolding=true])
				in
				    Result

	annotation PBI_ResultType = Table

