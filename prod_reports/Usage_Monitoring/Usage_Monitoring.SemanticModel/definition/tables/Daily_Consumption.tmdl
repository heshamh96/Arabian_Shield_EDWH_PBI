/// Credits per day, account-wide.
table Daily_Consumption
	lineageTag: 9d5df39f-d940-49d1-a73e-2f475919e90a

	column USAGE_DATE
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: a2a7dab9-a532-4f4f-93ea-f993f7713abf
		summarizeBy: none
		sourceColumn: USAGE_DATE

		annotation SummarizationSetBy = Automatic

	column TOTAL_CREDITS
		dataType: double
		lineageTag: a91a89e3-9ad9-4173-a4c9-33276a7a59b9
		summarizeBy: sum
		sourceColumn: TOTAL_CREDITS

		annotation SummarizationSetBy = Automatic

	column COMPUTE_CREDITS
		dataType: double
		lineageTag: b6dd36c8-bd36-457a-abc4-a9d167023c53
		summarizeBy: sum
		sourceColumn: COMPUTE_CREDITS

		annotation SummarizationSetBy = Automatic

	column CLOUD_SERVICES_CREDITS
		dataType: double
		lineageTag: 05b10e89-631d-47a0-ba55-7666133c56e1
		summarizeBy: sum
		sourceColumn: CLOUD_SERVICES_CREDITS

		annotation SummarizationSetBy = Automatic

	column WAREHOUSES_USED
		dataType: int64
		lineageTag: c9d582b0-3ff5-4789-a0b3-181c3abc2348
		summarizeBy: sum
		sourceColumn: WAREHOUSES_USED

		annotation SummarizationSetBy = Automatic

	measure 'Total Credits' = SUM(Daily_Consumption[TOTAL_CREDITS])
		formatString: #,0.00
		lineageTag: 91aade96-07ca-445b-8fb9-16b8f7916369

	measure 'Compute Credits' = SUM(Daily_Consumption[COMPUTE_CREDITS])
		formatString: #,0.00
		lineageTag: 68facdb2-ae4d-46c4-859a-0b1010aa18ba

	measure 'Cloud Services Credits' = SUM(Daily_Consumption[CLOUD_SERVICES_CREDITS])
		formatString: #,0.00
		lineageTag: 7884f500-429e-4c5d-acdd-6852a16c1443

	/// Snowflake bills cloud services only above 10% of compute; a high share is worth investigating.
	measure 'Cloud Services %' = DIVIDE([Cloud Services Credits], [Total Credits])
		formatString: 0.0%
		lineageTag: 2e75cb04-41bc-4a4f-9399-08bd905fe835

	measure 'Avg Daily Credits' = AVERAGE(Daily_Consumption[TOTAL_CREDITS])
		formatString: #,0.00
		lineageTag: 00eba0b7-2ff6-4eba-92a2-91b5d786a7b7

	measure 'Peak Daily Credits' = MAX(Daily_Consumption[TOTAL_CREDITS])
		formatString: #,0.00
		lineageTag: 0b41ae81-f412-498f-bd9f-7eaf7d8e4126

	measure 'Days Monitored' = DISTINCTCOUNT(Daily_Consumption[USAGE_DATE])
		formatString: #,0
		lineageTag: 9836c69c-6886-4c1e-aefa-8158ee0de5de

	measure 'Credits Last 7 Days' = CALCULATE([Total Credits], DATESINPERIOD('Date'[Date], MAX('Date'[Date]), -7, DAY))
		formatString: #,0.00
		lineageTag: 4b1cea30-4a0a-4880-bb9a-68d2e0156536

	measure 'Credits Prev 7 Days' = CALCULATE([Total Credits], DATESINPERIOD('Date'[Date], MAX('Date'[Date]) - 7, -7, DAY))
		formatString: #,0.00
		lineageTag: 54201c5e-b93c-49ba-812d-5656ff345ec7

	measure 'Credits WoW %' = DIVIDE([Credits Last 7 Days] - [Credits Prev 7 Days], [Credits Prev 7 Days])
		formatString: 0.0%
		lineageTag: e1f7cb42-7357-4b28-ba25-3c67cf1af44e

	measure 'Credits MTD' = CALCULATE([Total Credits], DATESMTD('Date'[Date]))
		formatString: #,0.00
		lineageTag: 8b6d1e30-0ee5-40cf-92e7-78eda813bc23

	/// Rolling mean - smooths the weekday/weekend saw-tooth.
	measure 'Credits 7D Avg' = AVERAGEX(DATESINPERIOD('Date'[Date], MAX('Date'[Date]), -7, DAY), [Total Credits])
		formatString: #,0.00
		lineageTag: b5276c02-5d0b-40c6-a157-19dc6f43fdd0

	/// Projected monthly credits at the current daily average.
	measure 'Run Rate (30d) Credits' = [Avg Daily Credits] * 30
		formatString: #,0.00
		lineageTag: c0f75070-8dbc-4f04-9efd-2573d9649829

	/// Unit economics: credits against data actually landed.
	measure 'Credits per Million Rows' = DIVIDE([Total Credits], DIVIDE([Rows (Latest)], 1000000))
		formatString: #,0.00
		lineageTag: b645eb6b-73bd-46b6-b61d-854ad1182279

	/// Credit burn per hour of dynamic-table refresh work.
	measure 'Credits per Refresh Hour' = DIVIDE([Total Credits], [Total Refresh Hours])
		formatString: #,0.00
		lineageTag: 058e980d-26e1-4947-b681-fb952e5b4277

	/// Day-to-day spread of daily credits. High volatility makes a run rate meaningless.
	measure 'Credits Volatility' = STDEVX.P(VALUES(Daily_Consumption[USAGE_DATE]), [Total Credits])
		formatString: #,0.00
		lineageTag: cfeb3801-73b4-4549-96cf-6368aa219eb7

	measure 'Days Above Avg Credits' = COUNTROWS(FILTER(VALUES(Daily_Consumption[USAGE_DATE]), [Total Credits] > [Avg Daily Credits]))
		formatString: #,0
		lineageTag: 068dff03-04e6-4399-8c2f-b1b1eb229b1b

	measure 'Weekend Credits' = CALCULATE([Total Credits], 'Date'[Is Weekend] = TRUE())
		formatString: #,0.00
		lineageTag: dbc281f7-e639-4e66-859f-24626f197206

	/// Credits burned on days nobody is working - usually pure schedule cost.
	measure 'Weekend Credits %' = DIVIDE([Weekend Credits], [Total Credits])
		formatString: 0.0%
		lineageTag: 261af40d-9957-4708-9eb8-555eae1875df

	measure 'Highest Credit Day' = CALCULATE(FIRSTNONBLANK('Date'[Date], 1), TOPN(1, ALLSELECTED('Date'[Date]), [Total Credits], DESC))
		formatString: yyyy-mm-dd
		lineageTag: 9fe65d03-e0a5-4b71-b008-0c3da972180e

	measure 'Credits per GB Stored' = DIVIDE([Total Credits], [Storage GB (Latest)])
		formatString: #,0.00
		lineageTag: 59ad5204-a784-4b6e-8888-587acf8a77b7

	partition Daily_Consumption = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases("ASCI-EDP_PRD.snowflakecomputing.com", "PROD_GOLD_WH", [Role="PROD_QLIK_READER_ROLE"]),
				    Db = Source{[Name="MONITORING_DB", Kind="Database"]}[Data],
				    Result = Value.NativeQuery(Db, "select USAGE_DATE, TOTAL_CREDITS, COMPUTE_CREDITS, CLOUD_SERVICES_CREDITS, WAREHOUSES_USED from SNOWFLAKE.VW_DAILY_CONSUMPTION_SUMMARY", null, [EnableFolding=true])
				in
				    Result

	annotation PBI_ResultType = Table

