/// Rolling 7-day hourly credit burn per warehouse.
table Hourly_Consumption
	lineageTag: 4d114e6d-0edf-41a8-a900-71bf4cad7c86

	measure 'Credits (7d)' = SUM(Hourly_Consumption[CREDITS_USED])
		formatString: #,0.00
		lineageTag: 9e1199c1-7d91-44ba-83d3-18a289ae4f60

	measure 'Active Warehouses' = DISTINCTCOUNT(Hourly_Consumption[WAREHOUSE_NAME])
		formatString: #,0
		lineageTag: 73ad15c8-e7d8-4e06-8a24-86b82baa0626

	measure 'Peak Hourly Credits' = MAX(Hourly_Consumption[CREDITS_USED])
		formatString: #,0.00
		lineageTag: 88a38a03-8a04-452f-a3fc-ea0b0e0fff92

	measure 'Active Hours' = CALCULATE(COUNTROWS(Hourly_Consumption), Hourly_Consumption[CREDITS_USED] > 0)
		formatString: #,0
		lineageTag: aa2ce671-27b6-4545-8279-ac618b8cac23

	measure 'Idle Hours' = CALCULATE(COUNTROWS(Hourly_Consumption), Hourly_Consumption[CREDITS_USED] = 0)
		formatString: #,0
		lineageTag: 6773da00-f4b2-4a59-8876-beb1224229f2

	measure 'Avg Credits per Active Hour' = DIVIDE([Credits (7d)], [Active Hours])
		formatString: #,0.00
		lineageTag: ddc1bcec-6fac-4210-83e5-d58fce3e4a4c

	/// Hour of day with the highest credit burn.
	measure 'Busiest Hour' = CALCULATE(FIRSTNONBLANK(Hourly_Consumption[USAGE_HOUR], 1), TOPN(1, ALLSELECTED(Hourly_Consumption[USAGE_HOUR]), [Credits (7d)], DESC))
		formatString: #,0
		lineageTag: 214281e6-1556-4bf4-9ffd-1d180c5f36ea

	/// Share of monitored hours where the warehouse did any work.
	measure 'Utilisation %' = DIVIDE([Active Hours], COUNTROWS(Hourly_Consumption))
		formatString: 0.0%
		lineageTag: d4027334-abfe-4024-96a9-1a35d3ee4840

	measure 'Off-Hours Credits' = CALCULATE([Credits (7d)], Hourly_Consumption[USAGE_HOUR] < 7 || Hourly_Consumption[USAGE_HOUR] > 19)
		formatString: #,0.00
		lineageTag: 99027fc0-faa1-485b-87c3-48533e8190cb

	/// Burn outside 07:00-19:00. Fine for batch, worth questioning otherwise.
	measure 'Off-Hours Credits %' = DIVIDE([Off-Hours Credits], [Credits (7d)])
		formatString: 0.0%
		lineageTag: 98b1dd76-7da3-48d8-b6c8-4b00a1beb08b

	measure 'Top Warehouse' = CALCULATE(FIRSTNONBLANK(Hourly_Consumption[WAREHOUSE_NAME], 1), TOPN(1, ALLSELECTED(Hourly_Consumption[WAREHOUSE_NAME]), [Credits (7d)], DESC))
		lineageTag: dc5aa82e-06d2-4621-a5c4-3cc59f7dc4f8

	/// Share of credits burned by the single busiest warehouse.
	measure 'Warehouse Concentration %' = DIVIDE(MAXX(VALUES(Hourly_Consumption[WAREHOUSE_NAME]), [Credits (7d)]), [Credits (7d)])
		formatString: 0.0%
		lineageTag: 751407f6-8039-475d-aa21-9f915f8fc73d

	measure 'Busiest Day of Week' = CALCULATE(FIRSTNONBLANK('Date'[Day of Week], 1), TOPN(1, ALLSELECTED('Date'[Day of Week]), [Credits (7d)], DESC))
		lineageTag: a23a8da6-6218-4b79-a3e8-553ce01e3ee3

	column WAREHOUSE_ID
		dataType: double
		lineageTag: 43bf864c-ca6e-4ab2-a430-f9212ad4987f
		summarizeBy: count
		sourceColumn: WAREHOUSE_ID

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column WAREHOUSE_NAME
		dataType: string
		lineageTag: 2df50ef0-2e55-41f0-bc15-a18ebcb86f40
		summarizeBy: none
		sourceColumn: WAREHOUSE_NAME

		annotation SummarizationSetBy = Automatic

	column START_TIME
		dataType: dateTime
		lineageTag: 0ea5fd6f-3e2b-48a8-9933-33be5f320e34
		summarizeBy: none
		sourceColumn: START_TIME

		annotation SummarizationSetBy = Automatic

	column END_TIME
		dataType: dateTime
		lineageTag: 4b9080b8-8f7e-4f1a-892e-8ac1bdcff496
		summarizeBy: none
		sourceColumn: END_TIME

		annotation SummarizationSetBy = Automatic

	column USAGE_DATE
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: bc9fff61-61ef-40c0-b998-71ad691a0b35
		summarizeBy: none
		sourceColumn: USAGE_DATE

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column USAGE_HOUR
		dataType: double
		lineageTag: c61b5b1e-8e20-4986-898b-de5352738ad8
		summarizeBy: sum
		sourceColumn: USAGE_HOUR

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column CREDITS_USED
		dataType: double
		lineageTag: 12f71202-25bd-452f-9077-09b937951e3b
		summarizeBy: sum
		sourceColumn: CREDITS_USED

		annotation SummarizationSetBy = Automatic

	column CREDITS_USED_COMPUTE
		dataType: double
		lineageTag: 7cf28c98-f5e1-4fcb-9225-fd2e257d5ab8
		summarizeBy: sum
		sourceColumn: CREDITS_USED_COMPUTE

		annotation SummarizationSetBy = Automatic

	column CREDITS_USED_CLOUD_SERVICES
		dataType: double
		lineageTag: 140196b9-d076-42b3-a1ba-0bbaee66c35c
		summarizeBy: sum
		sourceColumn: CREDITS_USED_CLOUD_SERVICES

		annotation SummarizationSetBy = Automatic

	partition Hourly_Consumption = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases("ASCI-EDP_PRD.snowflakecomputing.com", "PROD_GOLD_WH", [Role="PROD_QLIK_READER_ROLE"]),
				    Db = Source{[Name="MONITORING_DB", Kind="Database"]}[Data],
				    Result = Value.NativeQuery(Db, "select WAREHOUSE_ID, WAREHOUSE_NAME, START_TIME, END_TIME, cast(START_TIME as date) as USAGE_DATE, hour(START_TIME) as USAGE_HOUR, CREDITS_USED, CREDITS_USED_COMPUTE, CREDITS_USED_CLOUD_SERVICES from SNOWFLAKE.VW_VWH_HOURLY_CONSUMPTION_7D", null, [EnableFolding=true])
				in
				    Result

	annotation PBI_ResultType = Table

