/// Daily row-count and storage snapshot per table. Semi-additive: sum across tables, not across days.
table Table_Snapshots
	lineageTag: b260f2c7-3665-4d7b-b1b8-57aab1efd28b

	column SNAPSHOT_DATE
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 3cf6e6d4-a243-4176-bd4e-6fb1cdbc85b6
		summarizeBy: none
		sourceColumn: SNAPSHOT_DATE

		annotation SummarizationSetBy = Automatic

	column SNAPSHOT_TIME
		dataType: dateTime
		lineageTag: f71b4ad9-1ed6-466c-bfa6-dd35bd8651ee
		summarizeBy: none
		sourceColumn: SNAPSHOT_TIME

		annotation SummarizationSetBy = Automatic

	column DATABASE_NAME
		dataType: string
		lineageTag: ea0d6d0b-3132-4169-95d4-43c955c48b13
		summarizeBy: none
		sourceColumn: DATABASE_NAME

		annotation SummarizationSetBy = Automatic

	column LAYER
		dataType: string
		lineageTag: f31dc2be-36a8-473f-b579-2d07dd85d4dc
		summarizeBy: none
		sourceColumn: LAYER

		annotation SummarizationSetBy = Automatic

	column SCHEMA_NAME
		dataType: string
		lineageTag: da4971ee-c172-455c-ab78-e36c57791711
		summarizeBy: none
		sourceColumn: SCHEMA_NAME

		annotation SummarizationSetBy = Automatic

	column TABLE_NAME
		dataType: string
		lineageTag: d01d1740-9884-4db3-9ae9-90adcc1dd983
		summarizeBy: none
		sourceColumn: TABLE_NAME

		annotation SummarizationSetBy = Automatic

	column IS_DYNAMIC
		dataType: string
		lineageTag: d572cfde-b5d5-4500-804b-0ce486232d7f
		summarizeBy: none
		sourceColumn: IS_DYNAMIC

		annotation SummarizationSetBy = Automatic

	column ROW_COUNT
		dataType: int64
		lineageTag: 3d76ad5d-9a69-4284-9834-d3a07b6bf9f5
		summarizeBy: sum
		sourceColumn: ROW_COUNT

		annotation SummarizationSetBy = Automatic

	column BYTES
		dataType: int64
		lineageTag: c98ed4c5-a86a-452b-afe6-1c1bb944e4c8
		summarizeBy: sum
		sourceColumn: BYTES

		annotation SummarizationSetBy = Automatic

	column RETENTION_TIME
		dataType: int64
		lineageTag: 701fdbb9-b223-4b57-84ff-b9a1a7c1f0aa
		summarizeBy: none
		sourceColumn: RETENTION_TIME

		annotation SummarizationSetBy = Automatic

	column CREATED_AT
		dataType: dateTime
		lineageTag: b8c912ce-a2aa-428c-834d-287e0d148889
		summarizeBy: none
		sourceColumn: CREATED_AT

		annotation SummarizationSetBy = Automatic

	column LAST_ALTERED
		dataType: dateTime
		lineageTag: 72405c41-12c9-444e-96fe-af8e85ecfc46
		summarizeBy: none
		sourceColumn: LAST_ALTERED

		annotation SummarizationSetBy = Automatic

	column TABLE_COMMENT
		dataType: string
		lineageTag: f4dfea82-6464-4764-ac33-9e6595f6002e
		summarizeBy: none
		sourceColumn: TABLE_COMMENT

		annotation SummarizationSetBy = Automatic

	hierarchy Storage
		lineageTag: 94a8306b-cab3-4a49-9f73-334780995e02

		level LAYER
			lineageTag: c22bddb8-cfa3-436b-be73-4df09d0d1c53
			column: LAYER

		level SCHEMA_NAME
			lineageTag: 4bd283c4-c991-4a08-9e6c-f30881602d4e
			column: SCHEMA_NAME

		level TABLE_NAME
			lineageTag: 68997959-bb5d-403b-ae15-1dd752dea783
			column: TABLE_NAME

	/// Only meaningful with a single date in filter context.
	measure 'Rows (Snapshot)' = SUM(Table_Snapshots[ROW_COUNT])
		formatString: #,0
		lineageTag: 7f719a14-4278-4909-89e0-5e3a7a7daaf7

	measure 'Storage GB (Snapshot)' = DIVIDE(SUM(Table_Snapshots[BYTES]), 1073741824)
		formatString: #,0.00
		lineageTag: 39c3c9ba-8f79-4c02-a8be-27fc89e22da2

	/// Semi-additive: takes the most recent snapshot rather than summing every day.
	measure 'Rows (Latest)' = CALCULATE([Rows (Snapshot)], LASTNONBLANK('Date'[Date], [Rows (Snapshot)]))
		formatString: #,0
		lineageTag: 997c4fa2-0d2d-478e-8c27-3e301f2bee09

	measure 'Storage GB (Latest)' = CALCULATE([Storage GB (Snapshot)], LASTNONBLANK('Date'[Date], [Rows (Snapshot)]))
		formatString: #,0.00
		lineageTag: e6935885-c6e6-4471-859b-571ceebb348f

	measure 'Rows 7D Ago' = CALCULATE([Rows (Latest)], DATEADD('Date'[Date], -7, DAY))
		formatString: #,0
		lineageTag: 3b52b673-12ae-4c62-bd3b-aa93fbd8b6ad

	measure 'Row Growth 7D' = [Rows (Latest)] - [Rows 7D Ago]
		formatString: #,0
		lineageTag: eb95ef7d-e18d-4979-abd5-9f5d9921fa3f

	measure 'Row Growth 7D %' = DIVIDE([Row Growth 7D], [Rows 7D Ago])
		formatString: 0.0%
		lineageTag: d697feba-dced-41aa-af24-7a70073cb88e

	measure 'Storage GB 7D Ago' = CALCULATE([Storage GB (Latest)], DATEADD('Date'[Date], -7, DAY))
		formatString: #,0.00
		lineageTag: a36c4109-53e4-4617-9381-612f88064d83

	measure 'Storage Growth 7D %' = DIVIDE([Storage GB (Latest)] - [Storage GB 7D Ago], [Storage GB 7D Ago])
		formatString: 0.0%
		lineageTag: 9256857e-e94a-4d7a-97b1-7d3d0c6b2042

	measure 'Rows 30D Ago' = CALCULATE([Rows (Latest)], DATEADD('Date'[Date], -30, DAY))
		formatString: #,0
		lineageTag: badf05ae-7f03-4113-b154-05d4c8da9295

	measure 'Row Growth 30D %' = DIVIDE([Rows (Latest)] - [Rows 30D Ago], [Rows 30D Ago])
		formatString: 0.0%
		lineageTag: 562c6f49-52c3-40ca-842b-73caff8ab188

	/// Mean rows added per day over the last 30 days.
	measure 'Avg Daily Row Growth' = DIVIDE([Row Growth 30D %] * [Rows 30D Ago], 30)
		formatString: #,0
		lineageTag: 566a623a-434f-4526-a5b9-8132ce0a9602

	measure 'Tables in Snapshot' = DISTINCTCOUNT(Table_Snapshots[TABLE_NAME])
		formatString: #,0
		lineageTag: 6bc2fe67-460e-4cfa-a538-2f499309718c

	/// Row width. A jump usually means a schema change or poor clustering.
	measure 'Avg Bytes per Row' = DIVIDE(CALCULATE(SUM(Table_Snapshots[BYTES]), LASTNONBLANK('Date'[Date], [Rows (Snapshot)])), [Rows (Latest)])
		formatString: #,0.00
		lineageTag: 893610c3-6d28-4c73-b855-727e7d14fda4

	measure 'Fastest Growing Table' = CALCULATE(FIRSTNONBLANK(Table_Snapshots[TABLE_NAME], 1), TOPN(1, ALLSELECTED(Table_Snapshots[TABLE_NAME]), [Row Growth 7D], DESC))
		lineageTag: 418673d8-77f0-4b8f-851f-5f348a149008

	measure 'Tables Growing' = COUNTROWS(FILTER(VALUES(Table_Snapshots[TABLE_NAME]), [Row Growth 7D] > 0))
		formatString: #,0
		lineageTag: 0525800b-c1ed-4820-9b0b-66cbed23fd1c

	/// Shrinking tables are usually intentional pruning - or an upstream feed that broke.
	measure 'Tables Shrinking' = COUNTROWS(FILTER(VALUES(Table_Snapshots[TABLE_NAME]), [Row Growth 7D] < 0))
		formatString: #,0
		lineageTag: 772e975e-626c-4c5e-8e2d-ee98c1a973a8

	measure 'Tables Static 7D' = COUNTROWS(FILTER(VALUES(Table_Snapshots[TABLE_NAME]), [Row Growth 7D] = 0))
		formatString: #,0
		lineageTag: 10e35204-dda1-4c82-8257-fd7c57737740

	measure 'Daily Growth GB' = DIVIDE([Storage GB (Latest)] - [Storage GB 7D Ago], 7)
		formatString: #,0.00
		lineageTag: 39eedcbb-7f4c-44e8-9153-a88be7a3bcc1

	/// Straight-line projection from the last 7 days - a planning hint, not a forecast.
	measure 'Projected GB in 90d' = [Storage GB (Latest)] + [Daily Growth GB] * 90
		formatString: #,0.00
		lineageTag: a0f7d019-96cd-41c2-9afc-80f04cfde0e4

	partition Table_Snapshots = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases("ASCI-EDP_PRD.snowflakecomputing.com", "PROD_GOLD_WH", [Role="PROD_QLIK_READER_ROLE"]),
				    Db = Source{[Name="MONITORING_DB", Kind="Database"]}[Data],
				    Result = Value.NativeQuery(Db, "select cast(SNAPSHOT_TIME as date) as SNAPSHOT_DATE, SNAPSHOT_TIME, DATABASE_NAME, SCHEMA_NAME as LAYER, SCHEMA_NAME, TABLE_NAME, IS_DYNAMIC, ROW_COUNT, BYTES, RETENTION_TIME, CREATED_AT, LAST_ALTERED, ""COMMENT"" as TABLE_COMMENT from SNOWFLAKE.TABLE_COUNT_DAILY_SNAPSHOTS", null, [EnableFolding=true])
				in
				    Result

	annotation PBI_ResultType = Table

